# AI6: shared Docker baseline; mount and peer permissions live in each role.
# Install as /etc/apparmor.d/abstractions/ai6-container-base.

include <abstractions/base>
network,
deny network alg,
deny network vsock,
capability,
file,
signal (receive) peer=unconfined,
signal (receive) peer=runc,
signal (receive) peer=crun,

# Replace Docker's OCI masked/readonly paths for the two execution roles.
# Match oldroot/newroot and further pivot aliases as well as the final root.
deny /{,**/}proc/{acpi,asound,interrupts,kcore,keys,latency_stats,sched_debug,scsi,timer_list,timer_stats}{,/**} rwklmx,
deny /{,**/}sys/{devices/virtual/powercap,firmware}{,/**} rwklmx,
deny /{,**/}proc/{bus,fs,irq,sys,sysrq-trigger}{,/**} wkl,
# The left side is the new link name; deny aliases of protected targets too.
deny link /** -> /{,**/}proc/{acpi,asound,interrupts,kcore,keys,latency_stats,sched_debug,scsi,timer_list,timer_stats,bus,fs,irq,sys,sysrq-trigger}{,/**},
deny link /** -> /{,**/}sys/{devices/virtual/powercap,firmware}{,/**},

deny @{PROC}/* w,
deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
deny @{PROC}/sys/[^k]** w,
deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
deny @{PROC}/sysrq-trigger rwklx,
deny @{PROC}/kcore rwklx,
deny /sys/[^f]*/** wklx,
deny /sys/f[^s]*/** wklx,
deny /sys/fs/[^c]*/** wklx,
deny /sys/fs/c[^g]*/** wklx,
deny /sys/fs/cg[^r]*/** wklx,
deny /sys/firmware/** rwklx,
deny /sys/devices/virtual/powercap/** rwklx,
deny /sys/kernel/security/** rwklx,
