APP_NAME=AI6
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database

DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_QUEUE_RETRY_AFTER=90

AI6_WORKER_TIMEOUT=60
AI6_WORKER_HEARTBEAT_MAX_AGE=75
AI6_SCHEDULER_HEARTBEAT_MAX_AGE=25
AI6_AGENT_HEARTBEAT_MAX_AGE=15
AI6_CHECKER_HEARTBEAT_MAX_AGE=15
AI6_IDLE_HEARTBEAT_INTERVAL=5
AI6_HTTP_PORT=8080
AI6_RUN_COMPOSE_SMOKE=0

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ai6@example.com"
MAIL_FROM_NAME="${APP_NAME}"
