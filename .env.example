APP_NAME=AI6
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=database
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=database

AI6_AUTH_LOGIN_MAX_ATTEMPTS=5
AI6_AUTH_LOGIN_DECAY_SECONDS=60
AI6_AUTH_SESSION_LIFETIME_MINUTES=120
AI6_AUTH_LOGIN_CONFIRMATION_TTL_SECONDS=600
AI6_AUTH_LOGIN_CONFIRMATION_MAX_ATTEMPTS=5
AI6_AUTH_STRONG_AUTHENTICATION_MAX_ATTEMPTS=5
AI6_AUTH_STRONG_AUTHENTICATION_DECAY_SECONDS=300
AI6_AUTH_LOGIN_CONFIRMATION_RESEND_COOLDOWN_SECONDS=30
AI6_AUTH_STEP_UP_WINDOW_SECONDS=300
AI6_AUTH_ENROLLMENT_TTL_SECONDS=900
AI6_LOGIN_CONFIRMATION_EMAIL=

DB_CONNECTION=sqlite
DB_FOREIGN_KEYS=true
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_QUEUE_RETRY_AFTER=360

AI6_WORKER_TIMEOUT=60
AI6_WORKER_HEARTBEAT_MAX_AGE=75
AI6_SCHEDULER_HEARTBEAT_MAX_AGE=25
AI6_AGENT_HEARTBEAT_MAX_AGE=15
AI6_CHECKER_HEARTBEAT_MAX_AGE=15
AI6_IDLE_HEARTBEAT_INTERVAL=5
AI6_HTTP_PORT=8080
AI6_HTTP_TRUSTED_HOSTS=localhost,127.0.0.1,::1
AI6_HTTP_TRUSTED_PROXIES=
AI6_HTTP_SESSION_SAME_SITE=lax
AI6_RUN_COMPOSE_SMOKE=0

AI6_SECURITY_PROFILE=strict
AI6_SECURITY_ACKNOWLEDGE_REDUCED_MODE=false
AI6_SECURITY_LOGIN_EMAIL_CONFIRMATION=true
AI6_SECURITY_REQUIRE_PRIVILEGED_PASSKEY=true
AI6_SECURITY_REQUIRE_CRITICAL_ACTION_STEP_UP=true
AI6_SECURITY_REQUIRE_HTTPS_OR_PRIVATE_ACCESS=true
AI6_SECURITY_REQUIRE_AGENT_SANDBOX=true
AI6_SECURITY_REQUIRE_CHECKER_NETWORK_ISOLATION=true
AI6_SECURITY_REQUIRE_LLM_PRECOMMIT_REVIEW=true

AI6_REDACTION_ACTIVE_KEY_ID=app-key-v1
# Außerhalb von APP_ENV=local/testing ist ein expliziter versionierter Ring erforderlich.
AI6_REDACTION_KEYS=

AI6_PROCESS_TIMEOUT_SECONDS=300
AI6_PROCESS_OUTPUT_LIMIT_BYTES=1048576
AI6_PROCESS_CANCEL_GRACE_MILLISECONDS=2000
AI6_PROCESS_WRAPPER_READY_TIMEOUT_SECONDS=30
AI6_PROCESS_SHELL_BINARY=/usr/bin/dash
AI6_PROCESS_SETSID_BINARY=/usr/bin/setsid
AI6_PROCESS_GROUP_KILL_BINARY=/usr/bin/kill
AI6_EFFECT_LOCK_DIRECTORY=/var/lib/ai6/managed/effect-locks
AI6_EFFECT_LOCK_OBJECT_COUNT=64
AI6_EFFECT_LOCK_WAIT_MILLISECONDS=25000
AI6_EFFECT_LOCK_OWNER_UID=0

AI6_GIT_BINARY=/usr/bin/git
AI6_GIT_SSH_BINARY=/usr/bin/ssh
AI6_GIT_EXECUTABLE_PATH=/usr/local/bin:/usr/bin:/bin
AI6_GIT_EXECUTION_HOME=/var/lib/ai6/git-home
AI6_GIT_XDG_CONFIG_HOME=/var/lib/ai6/git-home/xdg
AI6_GIT_GLOBAL_CONFIG=/opt/ai6/etc/gitconfig
AI6_GIT_HOOKS_PATH=/opt/ai6/etc/git-hooks
# Produktive Instanzen setzen exakte, kommaseparierte Werte und Host=SHA256-Fingerprints.
AI6_GIT_ALLOWED_HOSTS=
AI6_GIT_ALLOWED_REMOTE_PATHS=
AI6_GIT_ALLOWED_REF_PATTERNS=refs/heads/*
AI6_GIT_PINNED_HOST_KEYS=
AI6_MANAGED_PROJECT_ROOT=/var/lib/ai6/managed
AI6_DEPLOY_KEY_ROOT=/var/lib/ai6/managed/deploy-keys
AI6_SSH_KEYGEN_BINARY=/usr/bin/ssh-keygen
AI6_CONTROL_OPERATION_LEASE_SECONDS=120
AI6_CONTROL_OPERATION_HEARTBEAT_SECONDS=30
AI6_CONTROL_OPERATION_RECONCILER_SECONDS=30
AI6_CONTROL_OPERATION_MAX_ATTEMPTS=3

MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_URL=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS="ai6@example.com"
MAIL_FROM_NAME="${APP_NAME}"
